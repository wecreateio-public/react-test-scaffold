{
  "name": "react-test-scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:serve-nextjs-data & next",
    "dev_win": "(start /b \"\" npm run dev:serve-nextjs-data_win) && next",
    "build": "next build && npm run build:serve-nextjs-data",
    "start": "npm run start:serve-nextjs-data & next start",
    "dev:serve-nextjs-data": "NODE_ENV=development node -r ts-node/register --env-file=.env $([ -f .env.local ] && echo \"--env-file .env.local \") serveNextjsData/serve.ts",
    "dev:serve-nextjs-data_win": "(IF NOT EXIST .env.local (copy NUL .env.local)) && set NODE_ENV='development' && node -r ts-node/register --env-file=.env --env-file .env.local serveNextjsData/serve.ts",
    "build:serve-nextjs-data": "cd serveNextjsData && tsc && cd ..",
    "start:serve-nextjs-data": "NODE_ENV=production node --env-file=.env serveNextjsData/serve.js",
    "generate:graphql": "graphql-codegen --config ./codegen.yml",
    "lint": "next lint",
    "test:types": "tsc",
    "test:jest": "jest",
    "watch:typescript": "tsc -w",
    "fix:formatting": "prettier --write --plugin-search-dir=. ."
  },
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@apollo/client": "3.11.2",
    "@apollo/experimental-nextjs-app-support": "^0.11.2",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/lab": "5.0.0-alpha.173",
    "@mui/material": "^5.16.6",
    "@next/bundle-analyzer": "14.2.5",
    "css-mediaquery": "^0.1.2",
    "dayjs": "^1.11.12",
    "lodash": "^4.17.21",
    "next": "^14.2.5",
    "numeral": "^2.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/fragment-matcher": "^5.0.2",
    "@graphql-codegen/typescript": "^4.0.9",
    "@graphql-codegen/typescript-operations": "^4.2.3",
    "@graphql-codegen/typescript-react-apollo": "^4.3.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/css-mediaquery": "^0.1.4",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.7",
    "@types/numeral": "^2.0.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
